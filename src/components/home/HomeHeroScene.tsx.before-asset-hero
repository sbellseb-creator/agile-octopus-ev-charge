import {
  BatteryCharging,
  CloudSnow,
  Moon,
  PlugZap,
  Snowflake,
  Sparkles,
  Sun,
} from "lucide-react";

export type HomeSceneTheme =
  | "summer"
  | "winter"
  | "spring"
  | "autumn"
  | "easter"
  | "christmas"
  | "classic";

interface Props {
  theme: HomeSceneTheme;
  isNight: boolean;
  charging: boolean;
  batteryLevel?: number | null;
  chargeLimit?: number | null;
  chargerPowerKw?: number | null;
  state?: string | null;
}

const snow = [
  ["7%", "12%"], ["14%", "30%"], ["22%", "8%"],
  ["31%", "21%"], ["41%", "10%"], ["51%", "29%"],
  ["61%", "14%"], ["71%", "26%"], ["80%", "9%"],
  ["89%", "23%"], ["95%", "15%"],
] as const;

export default function HomeHeroScene({
  theme,
  isNight,
  charging,
  batteryLevel,
  chargeLimit,
  chargerPowerKw,
  state,
}: Props) {
  const winter = theme === "winter" || theme === "christmas";
  const spring = theme === "spring" || theme === "easter";
  const autumn = theme === "autumn";
  const summer = theme === "summer";

  const battery =
    batteryLevel !== null && batteryLevel !== undefined
      ? `${Math.round(batteryLevel)}%`
      : "—";

  const sky = winter
    ? isNight
      ? "from-[#07111f] via-[#152a46] to-[#7892aa]"
      : "from-[#8fb5d2] via-[#d7e7f2] to-[#f5f9fc]"
    : spring
      ? "from-[#62b9ed] via-[#a7ddf4] to-[#f8d5e5]"
    : autumn
      ? "from-[#9b4c32] via-[#df8a4d] to-[#f4c47d]"
    : summer
      ? "from-[#238fdc] via-[#67c7f3] to-[#d8f5ff]"
    : isNight
      ? "from-[#030712] via-[#101b31] to-[#293b58]"
      : "from-[#278fd2] via-[#79c9ed] to-[#dbf4ff]";

  const ground = winter
    ? "from-[#e9f2f7] via-[#d8e5eb] to-[#b7cad2]"
    : spring
      ? "from-[#65d39a] via-[#36a66e] to-[#176044]"
    : autumn
      ? "from-[#c9863c] via-[#94602f] to-[#493b28]"
    : "from-[#4fd5a4] via-[#20976f] to-[#0c5946]";

  return (
    <div
      className={`relative min-h-[330px] overflow-hidden rounded-[30px] bg-gradient-to-b ${sky}`}
    >
      {/* atmospheric glow */}
      <div className="absolute inset-0 bg-gradient-to-b from-white/5 via-transparent to-black/15" />

      {/* sun / moon */}
      {isNight ? (
        <>
          <Moon className="absolute right-7 top-6 h-10 w-10 text-slate-100 drop-shadow-[0_0_22px_rgba(255,255,255,.45)]" />
          <Sparkles className="absolute left-[18%] top-[13%] h-4 w-4 text-white/70" />
          <Sparkles className="absolute left-[58%] top-[9%] h-3 w-3 text-white/60" />
          <Sparkles className="absolute right-[24%] top-[25%] h-3 w-3 text-white/45" />
        </>
      ) : (
        <Sun className="absolute right-7 top-6 h-12 w-12 text-yellow-200 drop-shadow-[0_0_25px_rgba(253,224,71,.85)]" />
      )}

      {/* distant landscape */}
      <div
        className={`absolute inset-x-0 bottom-[22%] h-[35%] bg-gradient-to-b ${ground} opacity-80`}
        style={{
          clipPath:
            "polygon(0 50%, 12% 38%, 23% 48%, 38% 25%, 52% 48%, 67% 31%, 80% 45%, 100% 24%, 100% 100%, 0 100%)",
        }}
      />

      {/* foreground */}
      <div
        className={`absolute inset-x-0 bottom-0 h-[31%] bg-gradient-to-b ${ground}`}
      />

      {/* road */}
      <div className="absolute inset-x-0 bottom-[8%] h-[22%] bg-gradient-to-b from-slate-700/55 via-slate-900/70 to-slate-950/80" />
      <div className="absolute bottom-[17%] left-[7%] right-[7%] h-[2px] bg-white/20" />

      {/* snow */}
      {winter &&
        snow.map(([left, top], i) => (
          <Snowflake
            key={i}
            className="absolute h-3 w-3 text-white/80"
            style={{ left, top }}
          />
        ))}

      {winter && (
        <>
          <CloudSnow className="absolute left-[8%] top-[22%] h-9 w-9 text-white/55" />
          <div className="absolute bottom-[27%] left-[4%] h-12 w-7 bg-white/75 [clip-path:polygon(50%_0,100%_100%,0_100%)]" />
          <div className="absolute bottom-[27%] left-[9%] h-16 w-9 bg-white/65 [clip-path:polygon(50%_0,100%_100%,0_100%)]" />
        </>
      )}

      {theme === "christmas" && (
        <>
          <div className="absolute left-5 top-5 text-4xl drop-shadow-xl">🎄</div>
          <div className="absolute bottom-[26%] right-[7%] text-3xl">🎁</div>
        </>
      )}

      {theme === "easter" && (
        <>
          <div className="absolute left-6 top-6 text-3xl">🌸</div>
          <div className="absolute bottom-[25%] right-[6%] text-4xl">🐇</div>
          <div className="absolute bottom-[24%] left-[7%] text-2xl">🌷</div>
        </>
      )}

      {/* live status glass */}
      <div className="absolute left-5 top-5 z-30 min-w-[128px] rounded-[20px] border border-white/20 bg-slate-950/35 px-4 py-3 shadow-xl backdrop-blur-xl">
        <div className="flex items-center gap-2">
          <BatteryCharging
            className={`h-5 w-5 ${
              charging ? "text-emerald-300" : "text-white/80"
            }`}
          />
          <span className="text-3xl font-black tracking-tight text-white">
            {battery}
          </span>
        </div>

        <div className="mt-1 text-xs font-semibold text-white/85">
          {charging
            ? `${chargerPowerKw ? `${chargerPowerKw.toFixed(1)} kW · ` : ""}Charging`
            : state || "Vehicle status"}
        </div>

        {chargeLimit !== null && chargeLimit !== undefined && (
          <div className="mt-1 text-[10px] text-white/60">
            Target {Math.round(chargeLimit)}%
          </div>
        )}
      </div>

      {/* QUICKSILVER MODEL-Y INSPIRED CAR */}
      <div className="absolute bottom-[43px] left-1/2 z-20 h-[135px] w-[82%] max-w-[620px] -translate-x-1/2">

        {/* floor shadow */}
        <div className="absolute bottom-[3px] left-[12%] right-[8%] h-7 rounded-full bg-black/50 blur-xl" />

        {/* roof / glass canopy */}
        <div
          className="absolute bottom-[61px] left-[25%] h-[64px] w-[48%]
          rounded-[70%_72%_15%_15%]
          bg-gradient-to-b from-slate-200 via-slate-400 to-slate-600
          shadow-[0_8px_20px_rgba(0,0,0,.3)]"
        >
          <div
            className="absolute left-[8%] right-[7%] top-[8px] h-[39px]
            rounded-[70%_72%_20%_20%]
            bg-gradient-to-br from-slate-700 via-slate-900 to-black
            border border-white/15"
          />

          <div className="absolute left-[48%] top-[8px] h-[40px] w-[2px] bg-slate-400/30" />
        </div>

        {/* body */}
        <div
          className="absolute bottom-[29px] left-[4%] right-[3%] h-[66px]
          rounded-[48%_52%_25%_24%]
          border border-white/40
          bg-gradient-to-b from-[#f5f7f8] via-[#bcc4cb] to-[#66717d]
          shadow-[0_15px_28px_rgba(0,0,0,.45)]"
        >
          {/* metallic highlight */}
          <div className="absolute left-[11%] right-[13%] top-[8px] h-[8px] rounded-full bg-white/25 blur-[2px]" />

          {/* lower sill */}
          <div className="absolute bottom-[4px] left-[17%] right-[15%] h-[7px] rounded-full bg-slate-800/45" />

          {/* headlight */}
          <div className="absolute left-[4%] top-[21px] h-[11px] w-[9%] rounded-full bg-white shadow-[0_0_15px_rgba(255,255,255,.95)]" />

          {/* rear light */}
          <div className="absolute right-[3%] top-[20px] h-[12px] w-[8%] rounded-full bg-red-400 shadow-[0_0_14px_rgba(248,113,113,.95)]" />

          {/* door definition */}
          <div className="absolute bottom-[8px] left-[49%] top-[17px] w-px bg-slate-700/25" />
        </div>

        {/* wheels */}
        <div className="absolute bottom-[10px] left-[18%] h-12 w-12 rounded-full border-[7px] border-[#17191d] bg-gradient-to-br from-slate-300 via-slate-600 to-slate-900 shadow-xl">
          <div className="absolute inset-[9px] rounded-full border border-white/25 bg-slate-700" />
        </div>

        <div className="absolute bottom-[10px] right-[16%] h-12 w-12 rounded-full border-[7px] border-[#17191d] bg-gradient-to-br from-slate-300 via-slate-600 to-slate-900 shadow-xl">
          <div className="absolute inset-[9px] rounded-full border border-white/25 bg-slate-700" />
        </div>

        {/* charge port */}
        {charging && (
          <>
            <div className="absolute bottom-[61px] right-[7%] z-30 h-3 w-3 rounded-full bg-emerald-200 shadow-[0_0_16px_5px_rgba(52,211,153,.85)] animate-pulse" />

            <div className="absolute bottom-[9px] right-[-3%] h-[57px] w-[25%] rounded-br-[42px] border-b-[5px] border-r-[5px] border-emerald-300 shadow-[0_0_16px_rgba(52,211,153,.95)] animate-pulse" />

            <PlugZap className="absolute bottom-[58px] right-[-6%] h-8 w-8 text-emerald-200 drop-shadow-[0_0_10px_rgba(52,211,153,1)] animate-pulse" />
          </>
        )}
      </div>

      {/* charging pill */}
      {charging && (
        <div className="absolute bottom-3 left-1/2 z-40 -translate-x-1/2 rounded-full border border-emerald-300/40 bg-emerald-950/80 px-5 py-2 text-xs font-black tracking-[0.12em] text-emerald-200 shadow-[0_0_20px_rgba(52,211,153,.25)] backdrop-blur-xl">
          ⚡ LIVE CHARGING
        </div>
      )}

      {/* scene label */}
      <div className="absolute right-5 top-[78px] rounded-full border border-white/15 bg-black/15 px-3 py-1 text-[10px] font-semibold uppercase tracking-widest text-white/60 backdrop-blur-md">
        {theme} · {isNight ? "night" : "day"}
      </div>
    </div>
  );
}
