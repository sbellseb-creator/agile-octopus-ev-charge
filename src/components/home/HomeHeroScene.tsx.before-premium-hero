import {
  BatteryCharging,
  Moon,
  PlugZap,
  Snowflake,
  Sparkles,
  Sun,
} from "lucide-react";

export type HomeSceneTheme =
  | "summer"
  | "winter"
  | "spring"
  | "autumn"
  | "easter"
  | "christmas"
  | "classic";

interface Props {
  theme: HomeSceneTheme;
  isNight: boolean;
  charging: boolean;
  batteryLevel?: number | null;
  chargeLimit?: number | null;
  chargerPowerKw?: number | null;
  state?: string | null;
}

const snow = [
  ["8%", "12%"],
  ["18%", "31%"],
  ["30%", "9%"],
  ["42%", "24%"],
  ["55%", "12%"],
  ["66%", "30%"],
  ["78%", "8%"],
  ["88%", "25%"],
  ["94%", "15%"],
] as const;

export default function HomeHeroScene({
  theme,
  isNight,
  charging,
  batteryLevel,
  chargeLimit,
  chargerPowerKw,
  state,
}: Props) {
  const winter = theme === "winter" || theme === "christmas";
  const spring = theme === "spring" || theme === "easter";
  const summer = theme === "summer";
  const autumn = theme === "autumn";

  const sky = winter
    ? isNight
      ? "from-[#091225] via-[#172447] to-[#33466b]"
      : "from-[#aec9e4] via-[#dce8f2] to-[#eef4f8]"
    : spring
      ? "from-[#73c7f0] via-[#b8e6f5] to-[#f7d7e7]"
      : autumn
        ? "from-[#d47345] via-[#e9a65f] to-[#f5d2a0]"
        : summer
          ? "from-[#3f9fe8] via-[#79c7f2] to-[#d7f1ff]"
          : isNight
            ? "from-[#070b13] via-[#11182a] to-[#18243b]"
            : "from-[#3a8fd1] via-[#78bfe8] to-[#d5eef8]";

  const displayBattery =
    batteryLevel !== null && batteryLevel !== undefined
      ? `${Math.round(batteryLevel)}%`
      : "—";

  return (
    <div
      className={`relative min-h-[245px] overflow-hidden rounded-[28px] bg-gradient-to-b ${sky}`}
    >
      {/* Sky */}
      {isNight ? (
        <>
          <Moon className="absolute right-6 top-5 h-9 w-9 text-slate-100/90" />
          <Sparkles className="absolute left-[18%] top-7 h-4 w-4 text-white/60" />
          <Sparkles className="absolute right-[28%] top-16 h-3 w-3 text-white/40" />
        </>
      ) : (
        <Sun className="absolute right-6 top-5 h-11 w-11 text-yellow-200 drop-shadow-[0_0_16px_rgba(253,224,71,0.65)]" />
      )}

      {/* Seasonal decoration */}
      {winter &&
        snow.map(([left, top], i) => (
          <Snowflake
            key={i}
            className="absolute h-3 w-3 text-white/70"
            style={{ left, top }}
          />
        ))}

      {theme === "christmas" && (
        <div className="absolute left-5 top-5 text-3xl drop-shadow-lg">🎄</div>
      )}

      {theme === "easter" && (
        <>
          <div className="absolute left-5 top-5 text-3xl">🌸</div>
          <div className="absolute right-5 bottom-14 text-3xl">🐇</div>
        </>
      )}

      {/* Landscape */}
      <div
        className={`absolute inset-x-0 bottom-0 h-[42%] ${
          winter
            ? "bg-gradient-to-b from-slate-100/80 to-white"
            : spring
              ? "bg-gradient-to-b from-emerald-300/80 to-emerald-700"
              : autumn
                ? "bg-gradient-to-b from-amber-500/70 to-amber-900"
                : "bg-gradient-to-b from-emerald-400/70 to-emerald-800"
        }`}
      />

      <div className="absolute inset-x-0 bottom-0 h-[26%] bg-black/10" />

      {/* Status */}
      <div className="absolute left-4 top-4 z-20 max-w-[60%] rounded-2xl border border-white/20 bg-black/30 px-3 py-2 backdrop-blur-md">
        <div className="flex items-center gap-2">
          <BatteryCharging
            className={`h-4 w-4 ${
              charging ? "text-emerald-300" : "text-white/80"
            }`}
          />
          <span className="text-2xl font-black tracking-tight text-white">
            {displayBattery}
          </span>
        </div>

        <p className="mt-0.5 text-[11px] font-medium text-white/80">
          {charging
            ? `${chargerPowerKw ? `${chargerPowerKw.toFixed(1)} kW · ` : ""}Charging`
            : state || "Vehicle status"}
        </p>

        {chargeLimit !== null && chargeLimit !== undefined && (
          <p className="text-[10px] text-white/60">
            Target {Math.round(chargeLimit)}%
          </p>
        )}
      </div>

      {/* Quicksilver EV */}
      <div className="absolute bottom-[31px] left-1/2 z-10 h-[94px] w-[76%] max-w-[460px] -translate-x-1/2">
        {/* shadow */}
        <div className="absolute bottom-0 left-[9%] right-[9%] h-5 rounded-full bg-black/35 blur-md" />

        {/* roof */}
        <div className="absolute bottom-[45px] left-[25%] h-[42px] w-[48%] rounded-t-[70%] rounded-b-[25%] bg-gradient-to-b from-slate-100 via-slate-300 to-slate-500 shadow-xl">
          <div className="absolute inset-x-[9%] top-[7px] h-[25px] rounded-t-[65%] bg-gradient-to-b from-slate-700 to-slate-950/90" />
        </div>

        {/* body */}
        <div className="absolute bottom-[18px] left-[6%] right-[6%] h-[48px] rounded-[45%_48%_30%_28%] border border-white/40 bg-gradient-to-b from-zinc-100 via-slate-300 to-slate-600 shadow-[0_10px_22px_rgba(0,0,0,0.35)]">
          <div className="absolute right-[5%] top-[15px] h-2.5 w-6 rounded-full bg-red-500/80 shadow-[0_0_8px_rgba(239,68,68,0.7)]" />
          <div className="absolute left-[5%] top-[15px] h-2.5 w-6 rounded-full bg-white/90 shadow-[0_0_8px_rgba(255,255,255,0.7)]" />
        </div>

        {/* wheels */}
        <div className="absolute bottom-[5px] left-[20%] h-8 w-8 rounded-full border-[5px] border-zinc-800 bg-zinc-400 shadow-lg" />
        <div className="absolute bottom-[5px] right-[19%] h-8 w-8 rounded-full border-[5px] border-zinc-800 bg-zinc-400 shadow-lg" />

        {/* charging lead */}
        {charging && (
          <>
            <div className="absolute bottom-[30px] right-[-2%] h-[43px] w-[31%] rounded-br-[38px] border-b-[4px] border-r-[4px] border-emerald-300 shadow-[0_0_12px_rgba(52,211,153,0.95)] animate-pulse" />
            <PlugZap className="absolute bottom-[65px] right-[-5%] h-7 w-7 text-emerald-300 drop-shadow-[0_0_8px_rgba(52,211,153,0.9)] animate-pulse" />
          </>
        )}
      </div>

      {charging && (
        <div className="absolute bottom-3 left-1/2 z-20 -translate-x-1/2 rounded-full border border-emerald-300/50 bg-emerald-950/65 px-4 py-1.5 text-xs font-bold tracking-wide text-emerald-200 backdrop-blur-md">
          ⚡ LIVE CHARGING
        </div>
      )}
    </div>
  );
}
