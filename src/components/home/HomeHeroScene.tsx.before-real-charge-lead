import {
  BatteryCharging,
  CloudRain,
  CloudSnow,
  CloudSun,
  Moon,
  PlugZap,
  Sparkles,
  Sun,
} from "lucide-react";

import type { HomeScene } from "@/lib/home-scene";
import {
  homeCarAsset,
  homeSceneBackground,
} from "@/lib/home-scene-assets";

interface Props {
  scene: HomeScene;
  charging: boolean;
  batteryLevel?: number | null;
  chargeLimit?: number | null;
  chargerPowerKw?: number | null;
  state?: string | null;
}

function WeatherIcon({ scene }: { scene: HomeScene }) {
  if (scene.weather === "snow") {
    return <CloudSnow className="h-4 w-4" />;
  }

  if (
    scene.weather === "rain" ||
    scene.weather === "storm"
  ) {
    return <CloudRain className="h-4 w-4" />;
  }

  if (scene.phase === "night") {
    return <Moon className="h-4 w-4" />;
  }

  if (scene.weather === "clear") {
    return <Sun className="h-4 w-4" />;
  }

  return <CloudSun className="h-4 w-4" />;
}

export default function HomeHeroScene({
  scene,
  charging,
  batteryLevel,
  chargeLimit,
  chargerPowerKw,
  state,
}: Props) {
  const battery =
    batteryLevel != null
      ? `${Math.round(batteryLevel)}%`
      : "—";

  const background = homeSceneBackground(scene);
  const car = homeCarAsset();

  return (
    <div className="relative min-h-[380px] overflow-hidden rounded-[30px] bg-slate-950">

      {/* Real/generated weather scene */}
      <div
        className="absolute inset-0 bg-cover bg-center transition-all duration-700"
        style={{
          backgroundImage: `url("${background}")`,
        }}
      />

      {/* Fallback atmosphere while an image is unavailable */}
      <div className="absolute inset-0 bg-gradient-to-br from-slate-800 via-slate-900 to-slate-950 -z-10" />

      {/* Premium cinematic grading */}
      <div className="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-black/10" />
      <div className="absolute inset-0 bg-gradient-to-r from-black/35 via-transparent to-black/10" />

      {/* Top status */}
      <div className="absolute left-4 top-4 z-30 rounded-2xl border border-white/15 bg-black/35 px-4 py-3 shadow-2xl backdrop-blur-xl">
        <div className="flex items-center gap-2">
          <BatteryCharging
            className={
              charging
                ? "h-5 w-5 text-emerald-300"
                : "h-5 w-5 text-white/80"
            }
          />

          <span className="text-3xl font-black tracking-tight text-white">
            {battery}
          </span>
        </div>

        <div className="mt-1 text-xs font-semibold text-white/85">
          {charging
            ? `${chargerPowerKw != null
                ? `${chargerPowerKw.toFixed(1)} kW · `
                : ""
              }Charging`
            : state || "Last known status"}
        </div>

        {chargeLimit != null && (
          <div className="mt-1 text-[10px] text-white/65">
            Target {Math.round(chargeLimit)}%
          </div>
        )}
      </div>

      {/* Weather badge */}
      <div className="absolute right-4 top-4 z-30 flex items-center gap-2 rounded-full border border-white/15 bg-black/30 px-3 py-2 text-xs text-white/85 backdrop-blur-xl">
        <WeatherIcon scene={scene} />

        <span className="capitalize">
          {scene.mode === "forced"
            ? scene.theme
            : scene.weather.replace("-", " ")}
        </span>

        {scene.temperatureC != null && (
          <span className="font-bold">
            {Math.round(scene.temperatureC)}°
          </span>
        )}
      </div>

      {/* Quicksilver car artwork */}
      <img
        src={car}
        alt="Quicksilver electric vehicle"
        className="absolute bottom-[42px] left-1/2 z-20 w-[82%] max-w-[720px] -translate-x-1/2 object-contain drop-shadow-[0_28px_30px_rgba(0,0,0,.6)]"
        onError={(event) => {
          event.currentTarget.style.visibility = "hidden";
        }}
      />

      {/* Quicksilver vehicle layer */}
      <img
        src={car}
        alt="Quicksilver Model Y"
        className="absolute bottom-[34px] left-1/2 z-20 w-[78%] max-w-[690px] -translate-x-1/2 object-contain drop-shadow-[0_26px_28px_rgba(0,0,0,.55)]"
      />

      {/* Charging port pulse */}
      {charging && (
        <>
          <div className="absolute bottom-[123px] right-[17%] z-30 h-4 w-4 rounded-full bg-emerald-200 shadow-[0_0_24px_8px_rgba(52,211,153,.9)] animate-pulse" />

          <div className="absolute bottom-[44px] right-[7%] z-30 h-[86px] w-[18%] rounded-br-[64px] border-b-[5px] border-r-[5px] border-emerald-300 shadow-[0_0_18px_rgba(52,211,153,.95)] animate-pulse" />

          <PlugZap className="absolute bottom-[122px] right-[5%] z-30 h-8 w-8 text-emerald-200 drop-shadow-[0_0_12px_rgba(52,211,153,1)] animate-pulse" />

          <div className="absolute bottom-4 left-1/2 z-40 -translate-x-1/2 rounded-full border border-emerald-300/40 bg-emerald-950/80 px-5 py-2 text-xs font-black tracking-[0.13em] text-emerald-100 shadow-[0_0_24px_rgba(52,211,153,.3)] backdrop-blur-xl">
            ⚡ LIVE CHARGING
          </div>
        </>
      )}

      {/* Forced theme sparkle */}
      {scene.mode === "forced" && (
        <Sparkles className="absolute bottom-5 left-5 z-30 h-5 w-5 text-white/70" />
      )}
    </div>
  );
}
